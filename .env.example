# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
MANAGER_CHAT_ID=-1001234567890

# Database
DATABASE_TYPE=sqlite  # sqlite or postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=school_bot
SQLITE_PATH=./data/school_bot.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/bot.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# Cache
FAQ_CACHE_TTL=3600  # seconds
LEAD_CACHE_TTL=300  # seconds

# Backup
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # cron: every day at 2 AM
BACKUP_PROVIDER=local  # local, s3, gdrive
S3_BUCKET=your-bucket
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GDRIVE_FOLDER_ID=

# Google Sheets (optional)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_ID=
GOOGLE_CREDENTIALS_FILE=./credentials/google_credentials.json

# Language
DEFAULT_LANGUAGE=ru  # ru or en

# Rate Limiting
RATE_LIMIT_MESSAGES=5  # messages per minute
RATE_LIMIT_LEADS=3  # leads per hour
